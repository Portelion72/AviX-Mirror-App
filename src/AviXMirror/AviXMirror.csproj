<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AviXMirror</AssemblyName>
    <RootNamespace>AviXMirror</RootNamespace>
    <Product>AviX Mirror</Product>
    <Company>AVIX_3D</Company>
    <Authors>AVIX_3D</Authors>
    <Copyright>© 2026 AVIX_3D (avix3d.com) — tous droits réservés</Copyright>
    <!-- Remplacée à la publication d'une release par le numéro saisi (ex. v1.2.0 -> 1.2.0). -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="native\libusb-1.0.dll" Link="libusb-1.0.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\integrations\AssettoCorsa\AviXMirror\manifest.ini" LogicalName="AcApp.manifest.ini" />
    <EmbeddedResource Include="..\..\integrations\AssettoCorsa\AviXMirror\AviXMirror.lua" LogicalName="AcApp.AviXMirror.lua" />
    <EmbeddedResource Include="Assets\avix-logo.png" LogicalName="Brand.avix-logo.png" />
    <EmbeddedResource Include="Radar\CarFronts.txt" LogicalName="Radar.CarFronts.txt" />
    <None Include="native\libusb-NOTICE.txt" Link="libusb-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
  </ItemGroup>

</Project>
